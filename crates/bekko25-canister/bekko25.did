type Embedding = record {
  embedding_space : text;
  instructions : nat64;
  tokens : nat32;
  embedding : vec float32;
};
type ModelInfo = record {
  last_error : opt text;
  embedding_space : text;
  active : bool;
  weights_verified : bool;
  weight_pack_sha256 : text;
  layers : nat32;
  runtime_id : text;
  max_tokens : nat32;
  model_id : text;
  revision : text;
  dimensions : nat32;
  uploaded_bytes : nat64;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat; Err : text };
type Result_2 = variant { Ok : Embedding; Err : text };
type Result_3 = variant { Ok : nat64; Err : text };
service : () -> {
  activate : () -> (Result);
  beginUpload : () -> (Result);
  // Replicated read for the funding Wiki's timer. Never accepts or spends attached cycles.
  cycles_balance_for_wiki : () -> (Result_1);
  embed : (vec nat32) -> (Result_2) query;
  modelInfo : () -> (ModelInfo) query;
  upload : (nat64, blob) -> (Result_3);
}
